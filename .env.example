# PelaReeflet 配置示例：复制成 .env 后按需修改
# 注意：程序本身不自动读取 .env，请用你的进程管理器注入环境变量，
# 或者用 python-dotenv / direnv / systemd EnvironmentFile 加载。

# ===== 必填 =====
# 签名密钥。生成：python -c "import secrets; print(secrets.token_hex(32))"
REEFLET_SECRET=

# ===== 站点 =====
REEFLET_SITEKEY=reeflet-demo
REEFLET_HOSTNAME=

# ===== 难度与时效 =====
REEFLET_DIFFICULTY=20000
REEFLET_CHALLENGE_TTL=300
REEFLET_TICKET_TTL=300
REEFLET_CHALLENGE_RATE=2
REEFLET_CLICK_GATE=true

# ===== 风控阈值 =====
# 无头/自动化特征累加到多少分才拒绝
REEFLET_AUTOMATION_THRESHOLD=6
# 轨迹评分：默认只记录不拒绝，设 true 后超阈值直接拒
REEFLET_TRACK_STRICT=false
REEFLET_TRACK_THRESHOLD=4

# ===== 品牌与外观 =====
REEFLET_BRAND=PELAGIC BEACON
REEFLET_LOGO=/static/brand/pelareeflet-mark.svg
# dark / light / auto（跟随系统）
REEFLET_THEME=dark
# 是否显示右上角品牌角标（MIT 不强制，但强烈建议保留）
REEFLET_ATTRIBUTION=true

# ===== 页脚链接 =====
# 开源协议
REEFLET_LICENSE_URL=https://github.com/PelagicBeacon/PelaReeflet/blob/main/LICENSE
# 关于我们
REEFLET_ABOUT_URL=https://github.com/orgs/PelagicBeacon/repositories

# ===== 部署 =====
# 生产建议写成具体域名，例如 https://example.com,https://www.example.com
REEFLET_ALLOWED_ORIGINS=*
